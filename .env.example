# Configuración de entorno para VigilApp Frontend
# Copia este archivo a .env y actualiza los valores según tu entorno

# URL base del backend Spring Boot
# Desarrollo local: http://localhost:8080/api
# Desarrollo con dispositivo físico: http://<TU_IP>:8080/api (ejemplo: http://192.168.1.10:8080/api)
# Producción: https://tu-dominio.com/api
API_BASE_URL=http://localhost:8080/api

# Timeout para peticiones HTTP en milisegundos
API_TIMEOUT=30000
